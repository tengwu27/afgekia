# Vercel preview deployments should use the development Supabase project.
# Vercel production deployments should use the production Supabase project.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Vercel AI Gateway access for the authenticated project assistant.
# Vercel deployments use OIDC automatically; local/CI may use a static key.
# Keep the key server-only. Never prefix it with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
AI_MODEL=minimax/minimax-m3

# Playwright authenticated journeys (test environments only)
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_OWNER_DISPLAY_NAME=
E2E_SECOND_OWNER_EMAIL=
E2E_SECOND_OWNER_PASSWORD=
