{
  "name": "afgekia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled true",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.generated.ts",
    "db:verify": "npm run db:reset && npm run db:types && npm run db:lint && npm run db:test && npm run typecheck",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tiptap/core": "3.30.2",
    "@tiptap/html": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "radix-ui": "1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@vitest/coverage-v8": "4.1.11",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
